# Copy this file to `.env.local` and fill in real values.
# NEVER commit real secrets — `.env` and `.env.local` are gitignored.

# --- Neon Postgres (server-side only; used by the future backend/API layer) ---
DATABASE_URL=

# --- Neon Auth (public endpoints, not secret) ---
VITE_NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=            # server-side only — never VITE_ prefixed
VITE_STRIPE_PUBLISHABLE_KEY=  # safe for the browser

# --- Explore / demo mode (in-memory mock backend + login bypass) ---
# VITE_DEV_BYPASS_AUTH: therapist | client | admin — active under `vite` dev only.
VITE_DEV_BYPASS_AUTH=
# VITE_DEMO_MODE=true — enables the SAME mock demo in a PRODUCTION build
# (e.g. a shareable Vercel deploy). Leave empty for the real login/backend.
VITE_DEMO_MODE=
