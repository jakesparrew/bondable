# Production build config — committed ON PURPOSE (contains no secrets).
#
# The app has no real backend yet (the Neon/Auth/Stripe/Resend cutover is
# Phase 4). Until then, the ONLY meaningful production build is the shareable
# DEMO: the in-memory mock backend + the homepage role-bypass. This flag turns
# that on for `npm run build` (what Vercel runs), so the deploy just works with
# no env-var setup.
#
# REMOVE this file (or set the flag false) when the real backend lands in
# Phase 4 — at that point production must use the real API, not the mock.
VITE_DEMO_MODE=true
